{
  "Comment": "RONNAI batch pipeline: incoming/<source>_<year>.csv -> raw -> trusted/quarantine -> curated (Iceberg MERGE) -> verify. ตัวแทนค่า ARN ของ Lambda (CHECK_BATCH_ARN ฯลฯ) ถูกแทนด้วยค่าจริง ของ Lambda โดย infra/deploy_pipeline.sh",
  "StartAt": "CheckBatch",
  "States": {
    "CheckBatch": {
      "Type": "Task",
      "Resource": "${CHECK_BATCH_ARN}",
      "Retry": [{"ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"], "IntervalSeconds": 2, "MaxAttempts": 3, "BackoffRate": 2.0}],
      "Catch": [{"ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "PipelineFailed"}],
      "Next": "IsNewBatch"
    },
    "IsNewBatch": {
      "Type": "Choice",
      "Choices": [
        {"Variable": "$.status", "StringEquals": "NEW", "Next": "IngestBatch"},
        {"Variable": "$.status", "StringEquals": "ALREADY_PROCESSED", "Next": "AlreadyProcessed"}
      ],
      "Default": "Rejected"
    },
    "IngestBatch": {
      "Type": "Task",
      "Resource": "${INGEST_BATCH_ARN}",
      "Retry": [{"ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"], "IntervalSeconds": 2, "MaxAttempts": 3, "BackoffRate": 2.0}],
      "Catch": [{"ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "PipelineFailed"}],
      "Next": "ValidateBatch"
    },
    "ValidateBatch": {
      "Type": "Task",
      "Resource": "${VALIDATE_BATCH_ARN}",
      "Retry": [{"ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"], "IntervalSeconds": 2, "MaxAttempts": 3, "BackoffRate": 2.0}],
      "Catch": [{"ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "PipelineFailed"}],
      "Next": "ValidationResult"
    },
    "ValidationResult": {
      "Type": "Choice",
      "Choices": [
        {"Variable": "$.status", "StringEquals": "PASSED", "Next": "TransformBatch"},
        {"Variable": "$.status", "StringEquals": "PARTIAL", "Next": "TransformBatch"},
        {"Variable": "$.status", "StringEquals": "BATCH_BLOCKED", "Next": "BatchBlocked"}
      ],
      "Default": "PipelineFailed"
    },
    "TransformBatch": {
      "Type": "Task",
      "Resource": "${TRANSFORM_BATCH_ARN}",
      "Retry": [
        {"ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"], "IntervalSeconds": 2, "MaxAttempts": 3, "BackoffRate": 2.0},
        {"ErrorEquals": ["TransformError"], "IntervalSeconds": 30, "MaxAttempts": 3, "BackoffRate": 2.0}
      ],
      "Catch": [{"ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "PipelineFailed"}],
      "Next": "TransformResult"
    },
    "TransformResult": {
      "Type": "Choice",
      "Choices": [
        {"Variable": "$.status", "StringEquals": "TRANSFORMED", "Next": "VerifyBatch"},
        {"Variable": "$.status", "StringEquals": "WAITING_FOR_SOURCES", "Next": "WaitingForSources"}
      ],
      "Default": "PipelineFailed"
    },
    "VerifyBatch": {
      "Type": "Task",
      "Resource": "${VERIFY_BATCH_ARN}",
      "Retry": [{"ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"], "IntervalSeconds": 2, "MaxAttempts": 3, "BackoffRate": 2.0}],
      "Catch": [{"ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "PipelineFailed"}],
      "Next": "VerifyResult"
    },
    "VerifyResult": {
      "Type": "Choice",
      "Choices": [
        {"Variable": "$.status", "StringEquals": "SUCCESS", "Next": "PipelineSucceeded"},
        {"Variable": "$.status", "StringEquals": "VERIFY_FAILED", "Next": "VerifyFailed"}
      ],
      "Default": "PipelineFailed"
    },
    "AlreadyProcessed": {"Type": "Succeed", "Comment": "ไฟล์นี้ (เนื้อหาเดียวกัน) เคยประมวลผลสำเร็จแล้ว ไม่ทำซ้ำ"},
    "WaitingForSources": {"Type": "Succeed", "Comment": "ผ่าน gate และลง trusted แล้ว รอไฟล์ของแหล่งที่เหลือก่อนสร้าง curated"},
    "PipelineSucceeded": {"Type": "Succeed"},
    "Rejected": {"Type": "Fail", "Error": "RejectedFile", "Cause": "ชื่อไฟล์ใน incoming/ ไม่ตรงรูปแบบ <source>_<year>.csv หรือไม่มี contract ของ source นั้น"},
    "BatchBlocked": {"Type": "Fail", "Error": "BatchBlocked", "Cause": "ไฟล์ผิดระดับไฟล์ (คอลัมน์หาย/ไฟล์ว่าง/อ่านไม่ได้) ถูกกักทั้ง batch ใน quarantine/"},
    "VerifyFailed": {"Type": "Fail", "Error": "VerifyFailed", "Cause": "ตาราง curated ไม่ผ่านการตรวจ (จำนวนแถว/key ซ้ำ/coverage) ดู problems ใน output ของ VerifyBatch"},
    "PipelineFailed": {"Type": "Fail", "Error": "PipelineFailed", "Cause": "ขั้นใดขั้นหนึ่งล้มเหลว ดู error ใน execution history"}
  }
}
